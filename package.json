{
  "name": "coachpetersing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/check-content.mjs --built",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "prebuild": "node scripts/check-content.mjs && node scripts/fetch-posters.mjs",
    "check": "node scripts/check-content.mjs",
    "posters": "node scripts/fetch-posters.mjs",
    "pick": "tsx --env-file-if-exists=.env.local scripts/pick.ts",
    "waitlist-email": "tsx --env-file-if-exists=.env.local scripts/waitlist-email.ts",
    "stripe:setup": "tsx --env-file-if-exists=.env.local scripts/stripe-setup.ts",
    "sheet:setup": "tsx --env-file-if-exists=.env.local scripts/sheet-setup.ts"
  },
  "dependencies": {
    "@vercel/analytics": "^1.5.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "resend": "^6.32.1",
    "stripe": "^23.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.27",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0"
  }
}
