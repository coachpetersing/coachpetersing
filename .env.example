# Copy to .env.local for local dev. Add the same names in Vercel > Project > Settings > Environment Variables.
# Use Stripe test keys locally and in Preview; live keys in Production only.

# Stripe (Dashboard > Developers > API keys). `npm run stripe:setup` prints the price and coupon IDs.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_NOTES=price_...
STRIPE_PRICE_COACHING=price_...
STRIPE_COUPON_OPENING_DAY=opening-day
# Customer portal > "Login link" (https://billing.stripe.com/p/login/...)
STRIPE_PORTAL_LOGIN_URL=

# Resend (resend.com > API Keys). The sending domain must be verified.
RESEND_API_KEY=re_...
EMAIL_FROM="Peter Sing <peter@coachpetersing.com>"
EMAIL_PETER=contact@coachpetersing.com

# Google Sheets: the service account's JSON key, pasted whole or base64-encoded.
# Share the "Coaching Roster" sheet with the service account's client_email as an Editor.
GOOGLE_SERVICE_ACCOUNT_JSON=
# The long ID in the sheet's URL: docs.google.com/spreadsheets/d/<THIS>/edit
GOOGLE_SHEET_ID=

# Cloudflare Turnstile. Leave blank locally to skip the check.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Any long random string. Vercel Cron sends it; it also signs unsubscribe links.
CRON_SECRET=

# Private 45-minute Coaching call on Cal.com
NEXT_PUBLIC_CAL_COACHING_URL=https://cal.com/coachpetersing/coaching-45

NEXT_PUBLIC_SITE_URL=https://coachpetersing.com
